# ─────────────────────────────────────────────────────────────────────────
# BuyVanda — server-side environment
#
# Copy this to .env and fill it in. .env is gitignored; this file is not.
# NOTHING HERE REACHES THE BROWSER. Public values live in web/.env
#
# Grouped by the build step that needs them. Leave later groups blank —
# an empty value is fine until the code that reads it exists.
# ─────────────────────────────────────────────────────────────────────────


# ── Step 0 — Postgres ────────────────────────────────────────────────────
# Read by docker-compose.yml. These three only take effect the FIRST time
# the container initializes an empty data directory. Changing them later
# does nothing until you destroy the volume with `docker compose down -v`.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Read by api/, which runs natively — so the host is localhost, reached
# through the published port, NOT the compose service name.
# Percent-encode the password if it contains @ # / : or ?
DATABASE_URL=postgresql://user:password@localhost:5432/dbname


# ── Step 0 — API ─────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000


# ── Step 1 — migrations run as a separate role ───────────────────────────
# Invariant 10: the app's role holds no DDL rights. Same database, a
# different user that owns the schema. Blank until step 1 — at step 0 the
# bootstrap superuser is doing both jobs.
DATABASE_URL=


# ── Step 1 — Cognito ─────────────────────────────────────────────────────
# A real dev user pool in AWS; Cognito has no local emulator.
# The client secret is only used because the API does the token exchange
# server-side and sets httpOnly cookies (plan 02 §3). A browser-only SPA
# client would have no secret at all.
AWS_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=


# ── Step 10 — S3 uploads ─────────────────────────────────────────────────
# Locally, authenticate with a named profile from `aws configure` rather
# than putting long-lived access keys in a file. In production there are no
# credentials at all — the Lambda assumes an IAM role.
AWS_PROFILE=
S3_UPLOADS_BUCKET=


# ── Step 11 — Stripe ─────────────────────────────────────────────────────
# Test-mode keys only. The webhook secret comes from `stripe listen` locally
# and from the dashboard endpoint in production — they are different values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# ── Step 12 — scraper intake ─────────────────────────────────────────────
# Shared with the scraper repo. Scoped to /internal/sourcing/*, rate-limited
# separately, and rotated. Not a user credential.
SOURCING_SERVICE_TOKEN=


# ── Step 13 — email (provider not yet decided) ───────────────────────────
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
